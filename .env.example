# ==============================================================================
# DAYLOG - ARQUIVO DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para '.env' e configure as variáveis conforme seu ambiente.
# ==============================================================================

# Seleção de Ambiente: local | homologation | production
# - local: Conecta ao banco de dados SQLite nativo (default).
# - homologation: Conecta ao banco PostgreSQL do Supabase (deploy no Render).
# - production: Conecta ao banco PostgreSQL interno via Docker na Hostinger.
ENVIRONMENT=local

# Modo de Depuração (estritamente False quando ENVIRONMENT for diferente de 'local')
DEBUG=True

# Chave Secreta para Sessão e Segurança
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Configuração de Domínios Permitidos (Allowed Hosts) & CORS
ALLOWED_HOSTS=daylog.institutoviva.digital,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://daylog.institutoviva.digital,http://localhost:5000,http://127.0.0.1:5000

# Credenciais Iniciais de Usuário Admin (utilizado pelo script seed_users.py)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=sua_senha_admin_segura

# Configurações do Flask
FLASK_APP=run.py
FLASK_ENV=development

# ------------------------------------------------------------------------------
# 1. CONFIGURAÇÕES PARA AMBIENTE LOCAL (ENVIRONMENT=local)
# ------------------------------------------------------------------------------
# Nome do arquivo SQLite criado na raiz do projeto (Padrão: app.db)
SQLITE_DB_NAME=app.db

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES PARA AMBIENTE DE HOMOLOGAÇÃO (ENVIRONMENT=homologation)
# ------------------------------------------------------------------------------
# URL de Conexão com o banco PostgreSQL do Supabase (Render)
SUPABASE_DATABASE_URL=postgresql://usuario_supabase:senha_supabase@host_supabase.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES PARA AMBIENTE DE PRODUÇÃO (ENVIRONMENT=production)
# ------------------------------------------------------------------------------
# Conexão PostgreSQL via Docker na Hostinger (URL completa ou variáveis individuais)
DATABASE_URL=postgresql://postgres:senha_docker_producao@db:5432/daylog

# Parâmetros individuais de conexão (utilizados caso DATABASE_URL não seja informada)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_docker_producao
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=daylog

# ------------------------------------------------------------------------------
# 4. CAMINHO DOS ARQUIVOS ESTÁTICOS E MÍDIA (OPCIONAL)
# ------------------------------------------------------------------------------
# Deixe desmarcado para usar os caminhos absolutos baseados no diretório do projeto:
# STATIC_FOLDER=/caminho/absoluto/para/app/static
# MEDIA_FOLDER=/caminho/absoluto/para/app/media
